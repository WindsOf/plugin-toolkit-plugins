{
    "manifestVersion": "1.0",
    "plugin": {
        "id": "com.wip.psdbuilder.native",
        "name": "PSD Builder Native",
        "version": "4.4.3",
        "description": "A plugin that builds layered PSD files natively in Kotlin."
    },
    "requirements": {
        "minMemoryMb": 128,
        "minExecutionTimeMs": 10
    },
    "capabilities": [
        {
            "name": "Build PSD from Image and Texts",
            "description": "Generates a layered PSD natively in Kotlin from an image, texts and bounding boxes",
            "parameters": {
                "imagePath": {
                    "description": "Path to the base image (JPG, PNG, WebP)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "texts": {
                    "description": "List of text strings to render",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "balloonBoxes": {
                    "description": "List of bounding boxes for each balloon (ymin, xmin, ymax, xmax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "textBoxes": {
                    "description": "List of bounding boxes for each text (ymin, xmin, ymax, xmax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "fontSize": {
                    "defaultValue": 24,
                    "description": "Font size in pixels",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "fontName": {
                    "defaultValue": "ANIME_ACE_2_0_BB",
                    "description": "Typeface for the text",
                    "type": {
                        "type": "enum",
                        "className": "com.wip.psdbuilder.PsdFont",
                        "options": [
                            "ANIME_ACE_2_0_BB",
                            "ARIAL"
                        ]
                    }
                },
                "borderSize": {
                    "defaultValue": 3,
                    "description": "Thickness of the text stroke/border (0 to disable)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "outputDir": {
                    "defaultValue": "",
                    "description": "Directory to save generated PSD (leave empty to use image folder)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "leaveIntermediateFiles": {
                    "defaultValue": false,
                    "description": "Keep intermediate JSON and temp image files for debugging",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "textAngles": {
                    "description": "Rotations/Angles in degrees",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "DOUBLE"
                        }
                    }
                },
                "textColors": {
                    "description": "Text Colors",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "hasBorder": {
                    "description": "Has Border",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "BOOLEAN"
                        }
                    }
                },
                "borderColors": {
                    "description": "Border Colors",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "shapes": {
                    "description": "Shapes of the balloons",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                }
            },
            "returnType": {
                "type": "object",
                "className": "com.wip.psdbuilder.PSDBuildResult"
            },
            "semanticTypes": [
                {
                    "namespace": "sys",
                    "name": "file",
                    "variant": null
                }
            ],
            "outputs": [
                {
                    "name": "generated psd",
                    "description": "Path to the generated PSD file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "file",
                            "variant": null
                        }
                    ]
                }
            ]
        },
        {
            "name": "Build PSD for Chapter",
            "description": "Generates layered PSDs natively for a folder of images concurrently",
            "parameters": {
                "inputFolder": {
                    "description": "Path to folder containing chapter images",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "directory",
                            "variant": null
                        }
                    ]
                },
                "texts": {
                    "description": "List of text strings to render across all pages",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "balloonBoxes": {
                    "description": "List of bounding boxes for each balloon (ymin, xmin, ymax, xmax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "textBoxes": {
                    "description": "List of bounding boxes for each text (ymin, xmin, ymax, xmax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "pageNames": {
                    "description": "List of image filenames corresponding to each text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "outputDir": {
                    "defaultValue": "",
                    "description": "Directory to save generated PSDs (leave empty for 'output_psds' in input folder)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "fontSize": {
                    "defaultValue": 24,
                    "description": "Font size in pixels",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "fontName": {
                    "defaultValue": "ANIME_ACE_2_0_BB",
                    "description": "Typeface for the text",
                    "type": {
                        "type": "enum",
                        "className": "com.wip.psdbuilder.PsdFont",
                        "options": [
                            "ANIME_ACE_2_0_BB",
                            "ARIAL"
                        ]
                    }
                },
                "borderSize": {
                    "defaultValue": 3,
                    "description": "Thickness of the text stroke/border (0 to disable)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "leaveIntermediateFiles": {
                    "defaultValue": false,
                    "description": "Keep intermediate JSON and temp image files for debugging",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "textAngles": {
                    "description": "Rotations/Angles in degrees",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "DOUBLE"
                        }
                    }
                },
                "textColors": {
                    "description": "Text Colors",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "hasBorder": {
                    "description": "Has Border",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "BOOLEAN"
                        }
                    }
                },
                "borderColors": {
                    "description": "Border Colors",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "shapes": {
                    "description": "Shapes of the balloons",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                }
            },
            "returnType": {
                "type": "object",
                "className": "com.wip.psdbuilder.PSDBuildResult"
            },
            "semanticTypes": [
                {
                    "namespace": "sys",
                    "name": "file",
                    "variant": null
                }
            ],
            "outputs": [
                {
                    "name": "generated psd",
                    "description": "Path to the generated PSD file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "file",
                            "variant": null
                        }
                    ]
                }
            ]
        },
        {
            "name": "Build PSD from JSON",
            "description": "Generates a layered PSD natively from a given JSON file",
            "parameters": {
                "jsonPath": {
                    "description": "Path to JSON file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "outputPsdPath": {
                    "description": "Output PSD path",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            },
            "returnType": {
                "type": "object",
                "className": "com.wip.psdbuilder.PSDBuildResult"
            },
            "semanticTypes": [
                {
                    "namespace": "sys",
                    "name": "file",
                    "variant": null
                }
            ],
            "outputs": [
                {
                    "name": "generated psd",
                    "description": "Path to the generated PSD file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "file",
                            "variant": null
                        }
                    ]
                }
            ]
        },
        {
            "name": "Extract Text Layers from PSD",
            "description": "Reads a PSD file and returns a list of text layers with their text, position, and font info.",
            "parameters": {
                "psdPath": {
                    "description": "Path to PSD file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            },
            "returnType": {
                "type": "array",
                "items": {
                    "type": "object",
                    "className": "com.wip.psdbuilder.ExtractedText"
                }
            },
            "outputs": [
                {
                    "name": "result",
                    "description": "",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "className": "com.wip.psdbuilder.ExtractedText"
                        }
                    }
                }
            ]
        }
    ],
    "changelog": {
        "releases": [
            {
                "version": "3.0.1",
                "date": "2026-05-23",
                "categories": {
                    "Fixed": [
                        "Fixed a JSON decoding exception on plugin initialization by explicitly adding escaped double quotes to string default values (like \"Anime Ace 2.0 BB\") in capability parameters, ensuring compliance with kotlinx.serialization."
                    ]
                }
            },
            {
                "version": "3.0.0",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Added new `borderSize` parameter to capabilities, exposing stroke thickness to the UI. Passing 0 removes the border completely."
                    ]
                }
            },
            {
                "version": "2.1.4",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Added a 3-pixel white outline (stroke) layer effect to all generated text to improve readability over images."
                    ]
                }
            },
            {
                "version": "2.1.3",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Added spatial text centering functionality to calculate horizontal and vertical offsets automatically inside the bounding boxes."
                    ]
                }
            },
            {
                "version": "2.1.2",
                "date": "2026-05-23",
                "categories": {
                    "Fixed": [
                        "Corrected default font name in PSDBuilderPlugin and main.js from 'Anime ACE 2.0'/'ArialMT' to exactly 'Anime Ace 2.0 BB'."
                    ]
                }
            },
            {
                "version": "2.1.1",
                "date": "2026-05-23",
                "categories": {
                    "Fixed": [
                        "Fixed 'Invalid host defined options' runtime error for ESM modules by pre-bundling with ncc before pkg compilation."
                    ]
                }
            },
            {
                "version": "2.1.0",
                "date": "2026-05-23",
                "categories": {
                    "Changed": [
                        "Automate pkg compilation directly via Gradle build scripts."
                    ]
                }
            },
            {
                "version": "2.0.2",
                "date": "2026-05-23",
                "categories": {
                    "Changed": [
                        "Fixed executable packaging by explicitly bundling Jimp assets to resolve MODULE_NOT_FOUND errors at runtime."
                    ]
                }
            },
            {
                "version": "1.0.0",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Batch capability to process entire chapters concurrently (max 4 processes via Semaphore).",
                        "Smart word-wrapping text generation to fit bounding boxes.",
                        "Set \"Anime ACE 2.0\" as default fallback font."
                    ],
                    "Changed": [
                        "Refactored `executeBuilder` to be a coroutine suspend function.",
                        "Improved cleanup with safe `try-finally` blocks for temporary JSON files.",
                        "Added option `leaveIntermediateFiles` for advanced debugging."
                    ],
                    "Initial": [
                        "Initial release with PSD Builder capabilities"
                    ]
                }
            }
        ]
    },
    "hasUpdateHandler": true,
    "hasSetupHandler": true
}