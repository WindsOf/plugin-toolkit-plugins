{
    "manifestVersion": "1.0",
    "plugin": {
        "id": "com.wip.ocr_ia",
        "name": "OCR IA",
        "version": "1.1.0",
        "description": "Extract text from images using AI (Native Kotlin via Koog + Google Gemma-4-31b-it, or legacy Python)"
    },
    "requirements": {
        "minMemoryMb": 128,
        "minExecutionTimeMs": 10
    },
    "capabilities": [
        {
            "name": "ocr",
            "description": "Performs OCR on an image or a folder of images using native Kotlin (Koog)",
            "parameters": {
                "input": {
                    "description": "Path to image or folder",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "save": {
                    "defaultValue": true,
                    "description": "Save output to .txt file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "outputDir": {
                    "description": "Custom output directory",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "apiKey": {
                    "description": "Google GenAI API Key (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "usePython": {
                    "defaultValue": false,
                    "description": "Use legacy Python implementation",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                }
            },
            "returnType": {
                "type": "primitive",
                "primitiveType": "STRING"
            }
        }
    ],
    "changelog": {
        "releases": [
            {
                "version": "1.0.0",
                "date": "2026-05-10",
                "categories": {
                    "Initial": [
                        "Initial release of OCR IA plugin",
                        "AI-powered OCR using Google GenAI (Gemma-4-31b-it)",
                        "Support for single image and batch folder processing",
                        "Automatic results saving to .txt files",
                        "Customizable output directory and API key support",
                        "Progress reporting and cancellation handling",
                        "Automatic setup and resource extraction"
                    ]
                }
            }
        ]
    },
    "hasUpdateHandler": true,
    "hasSetupHandler": true
}