{
    "manifestVersion": "1.0",
    "plugin": {
        "id": "com.wip.ocr_ia",
        "name": "OCR IA",
        "version": "2.4.3",
        "description": "Advanced OCR plugin using Google AI, Anthropic, OpenAI, and LMStudio via Koog"
    },
    "requirements": {
        "minMemoryMb": 128,
        "minExecutionTimeMs": 10
    },
    "capabilities": [
        {
            "name": "ocr",
            "description": "Performs basic OCR on an image or a folder of images",
            "parameters": {
                "input": {
                    "description": "Path to image or folder",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "directory",
                            "variant": null
                        }
                    ]
                },
                "save": {
                    "defaultValue": true,
                    "description": "Save output to a .txt file alongside each image",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "outputDir": {
                    "description": "Custom output directory (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "useStructuredOutput": {
                    "defaultValue": false,
                    "description": "Whether to use native structured output (might not be supported by all models)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "saveThinking": {
                    "defaultValue": false,
                    "description": "Whether to save the thinking inside the json",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "model": {
                    "defaultValue": "GEMMA_26B",
                    "description": "The AI Model to use",
                    "type": {
                        "type": "enum",
                        "className": "com.wip.ocrAI.models.AIModel",
                        "options": [
                            "GEMMA_26B",
                            "GEMMA_31B",
                            "GEMINI_1_5_PRO",
                            "GEMINI_2_5_PRO",
                            "CLAUDE_3_5_SONNET",
                            "GPT_4O",
                            "LM_STUDIO"
                        ]
                    }
                }
            },
            "returnType": {
                "type": "object",
                "className": "com.wip.ocrAI.models.OCRResult",
                "properties": {
                    "texts": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "bb": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "pageNumbers": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "INT"
                        }
                    },
                    "pageNames": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "failedFiles": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                }
            },
            "outputs": [
                {
                    "name": "extracted text",
                    "description": "a list of strings representing the extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "bounding box",
                    "description": "(xmin, ymin, xmax, ymax), a list of lists of doubles representing the bounding box coordinates for each extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                {
                    "name": "page number",
                    "description": "a list of integers representing the page number (1-indexed) for each extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "INT"
                        }
                    }
                },
                {
                    "name": "page name",
                    "description": "a list of strings representing the filename/page name for each extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "failed files",
                    "description": "a list of strings representing the filenames that failed to process",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                }
            ]
        },
        {
            "name": "advanced_ocr",
            "description": "Performs advanced OCR extracting exact balloon and text boxes, shapes, text orientation, sparsity, and color.",
            "parameters": {
                "input": {
                    "description": "Path to image or folder",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "directory",
                            "variant": null
                        }
                    ]
                },
                "save": {
                    "defaultValue": true,
                    "description": "Save output to a .txt file alongside each image",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "outputDir": {
                    "description": "Custom output directory (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "useStructuredOutput": {
                    "defaultValue": false,
                    "description": "Whether to use native structured output (might not be supported by all models)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "saveThinking": {
                    "defaultValue": false,
                    "description": "Whether to save the thinking inside the json",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                },
                "model": {
                    "defaultValue": "GEMMA_31B",
                    "description": "The AI Model to use",
                    "type": {
                        "type": "enum",
                        "className": "com.wip.ocrAI.models.AIModel",
                        "options": [
                            "GEMMA_26B",
                            "GEMMA_31B",
                            "GEMINI_1_5_PRO",
                            "GEMINI_2_5_PRO",
                            "CLAUDE_3_5_SONNET",
                            "GPT_4O",
                            "LM_STUDIO"
                        ]
                    }
                }
            },
            "returnType": {
                "type": "object",
                "className": "com.wip.ocrAI.models.AdvancedOCRResult",
                "properties": {
                    "texts": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "balloonBoxes": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "textBoxes": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "shapes": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "fontStyles": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "fontFamilies": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "textAngles": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "DOUBLE"
                        }
                    },
                    "isSparse": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "BOOLEAN"
                        }
                    },
                    "textColors": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "hasBorder": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "BOOLEAN"
                        }
                    },
                    "borderColors": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "pageNumbers": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "INT"
                        }
                    },
                    "pageNames": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "failedFiles": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                }
            },
            "outputs": [
                {
                    "name": "extracted text",
                    "description": "a list of strings representing the extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "balloon bounding box",
                    "description": "(ymin, xmin, ymax, xmax), bounding box coordinates of the speech balloon",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                {
                    "name": "text bounding box",
                    "description": "(ymin, xmin, ymax, xmax), bounding box coordinates tightly wrapping the text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                {
                    "name": "balloon shapes",
                    "description": "shape of the speech balloon. Valid values are strictly: 'oval' or 'rectangular'",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "shape",
                            "variant": null
                        }
                    ]
                },
                {
                    "name": "font styles",
                    "description": "style of the text font. Valid values are strictly: 'normal', 'italic', 'bold', 'bold-italic'",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "font families",
                    "description": "general classification of the font, e.g., 'sans-serif', 'serif', 'handwritten', 'screaming'",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "text angles",
                    "description": "rotation angle of the text in degrees",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "DOUBLE"
                        }
                    }
                },
                {
                    "name": "is sparse",
                    "description": "whether the text is sparsely distributed inside the bounding box",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "BOOLEAN"
                        }
                    }
                },
                {
                    "name": "text colors",
                    "description": "color of the text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "has border",
                    "description": "whether the text has an outline/stroke",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "BOOLEAN"
                        }
                    }
                },
                {
                    "name": "border colors",
                    "description": "color of the text outline/stroke if present",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "page number",
                    "description": "a list of integers representing the page number (1-indexed) for each extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "INT"
                        }
                    }
                },
                {
                    "name": "page name",
                    "description": "a list of strings representing the filename/page name for each extracted text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                {
                    "name": "failed files",
                    "description": "a list of strings representing the filenames that failed to process",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                }
            ]
        }
    ],
    "settings": {
        "googleApiKey": {
            "description": "API Key for Google services",
            "type": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "required": true,
            "secret": true
        },
        "anthropicApiKey": {
            "description": "API Key for Anthropic services",
            "type": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "secret": true
        },
        "openAIApiKey": {
            "description": "API Key for OpenAI services",
            "type": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "secret": true
        },
        "lmStudioUrl": {
            "description": "URL for LM Studio (e.g. http://localhost:1234/v1)",
            "type": {
                "type": "primitive",
                "primitiveType": "STRING"
            }
        },
        "lmStudioApiKey": {
            "description": "API Key for LM Studio",
            "type": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "secret": true
        },
        "lmStudioModelName": {
            "description": "The specific model name to request from LM Studio",
            "type": {
                "type": "primitive",
                "primitiveType": "STRING"
            }
        }
    },
    "changelog": {
        "releases": [
            {
                "version": "2.4.3",
                "date": "2026-06-13",
                "categories": {
                    "Changes": [
                        "saving thinking to json is now disabled by default"
                    ]
                }
            },
            {
                "version": "2.4.2",
                "date": "2026-06-12",
                "categories": {
                    "Added": [
                        "Support for toolkit 1.6.0",
                        "Advancer ocr"
                    ]
                }
            },
            {
                "version": "2.3.5",
                "date": "2026-05-29",
                "categories": {
                    "Changed": [
                        "Aggiornato il prompt per ignorare gli SFX/onomatopee disegnati direttamente sull'artwork e fuori dai balloon."
                    ]
                }
            },
            {
                "version": "2.3.4",
                "date": "2026-05-25",
                "categories": {
                    "Changed": [
                        "Portato il numero di retry a 7 tentativi con un ritardo fisso di 10 secondi per ciascuno."
                    ]
                }
            },
            {
                "version": "2.3.3",
                "date": "2026-05-25",
                "categories": {
                    "Changed": [
                        "Aumentato il limite massimo di retry a 5 tentativi consecutivi (con ritardi progressivi)."
                    ]
                }
            },
            {
                "version": "2.3.2",
                "date": "2026-05-24",
                "categories": {
                    "Changed": [
                        "Esteso il meccanismo di retry (massimo 3 tentativi) anche alla fase di parsing e decodifica JSON per gestire le hallucination dell'intelligenza artificiale in modo automatico senza scartare subito la pagina."
                    ]
                }
            },
            {
                "version": "2.3.1",
                "date": "2026-05-23",
                "categories": {
                    "Changed": [
                        "Changed 'model' capability parameter type from String to AIModel Enum for better UI integration."
                    ]
                }
            },
            {
                "version": "2.3.0",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Added 'modelId' capability parameter to allow dynamic model selection via UI. Default is gemma-4-26b-a4b-it."
                    ]
                }
            },
            {
                "version": "2.2.2",
                "date": "2026-05-23",
                "categories": {
                    "Changed": [
                        "Switched model from gemma-4-31b-it to gemma-4-26b-a4b-it to resolve continuous Google API 500 Internal Server Errors."
                    ]
                }
            },
            {
                "version": "2.2.1",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Parallel execution support for batch OCR processing (max 5 concurrent requests).",
                        "Rate Limiting logic to respect API quotas (max 13 requests per minute).",
                        "Enhanced Thread-safety using Mutex for shared resources."
                    ],
                    "Changed": [
                        "Updated `retryWithBackoff` to use an optimized, pre-defined interval scale (5s, 10s, 10s, 10s, 2m).",
                        "Relocated system instruction prompt block to standard user text prompt to prevent Google API role strictness 500 errors."
                    ]
                }
            },
            {
                "version": "2.1.0",
                "date": "2026-05-20",
                "categories": {
                    "Added": [
                        "Support for toolkit 1.5.1"
                    ],
                    "Changes": [
                        "Now oce uses a new prompt and returns the list of text and the list of bounding boxes"
                    ]
                }
            },
            {
                "version": "2.0.5",
                "date": "2026-05-12",
                "categories": {
                    "Added": [
                        "Support for toolkit 1.5.0"
                    ]
                }
            },
            {
                "version": "2.0.3",
                "date": "2026-05-12",
                "categories": {
                    "Added": [
                        "Support for toolkit 1.4.0"
                    ]
                }
            },
            {
                "version": "1.0.0",
                "date": "2026-05-10",
                "categories": {
                    "Initial": [
                        "Initial release of OCR IA plugin",
                        "AI-powered OCR using Google GenAI (Gemma-4-31b-it)",
                        "Support for single image and batch folder processing",
                        "Automatic results saving to .txt files",
                        "Customizable output directory and API key support",
                        "Progress reporting and cancellation handling",
                        "Automatic setup and resource extraction"
                    ]
                }
            }
        ]
    },
    "hasUpdateHandler": true,
    "hasSetupHandler": true
}