{
    "manifestVersion": "1.0",
    "plugin": {
        "id": "com.wip.imageToolkit",
        "name": "Image Toolkit",
        "version": "1.1.1",
        "description": "A plugin that provides toolkit to work with images."
    },
    "requirements": {
        "minMemoryMb": 128,
        "minExecutionTimeMs": 10
    },
    "capabilities": [
        {
            "name": "Add Text to Image",
            "description": "Adds text to an image and saves as a layered PDF with vector text",
            "parameters": {
                "imagePath": {
                    "description": "Path to image",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "texts": {
                    "description": "Texts to add",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "bb": {
                    "description": "Bounding boxes to add, (xmin, ymin, xmax, ymax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "fontSize": {
                    "defaultValue": 20,
                    "description": "Font size (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "fontName": {
                    "defaultValue": "Arial",
                    "description": "Font name (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "pageNumber": {
                    "description": "Page number (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "pageName": {
                    "description": "Page name (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            },
            "returnType": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "outputs": [
                {
                    "name": "result",
                    "description": "",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            ]
        },
        {
            "name": "Add Text to Chapter",
            "description": "Adds text to a folder of images and saves as layered PDFs in an output directory",
            "parameters": {
                "inputFolder": {
                    "description": "Path to folder of images",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "directory",
                            "variant": null
                        }
                    ]
                },
                "texts": {
                    "description": "Texts to add",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "bb": {
                    "description": "Bounding boxes to add, (xmin, ymin, xmax, ymax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "pageNames": {
                    "description": "Page names corresponding to each text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "outputDir": {
                    "description": "Output directory",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "fontSize": {
                    "defaultValue": 20,
                    "description": "Font size (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "fontName": {
                    "defaultValue": "Arial",
                    "description": "Font name (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            },
            "returnType": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "outputs": [
                {
                    "name": "result",
                    "description": "",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            ]
        }
    ]
}