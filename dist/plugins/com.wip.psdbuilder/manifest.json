{
    "manifestVersion": "1.0",
    "plugin": {
        "id": "com.wip.psdbuilder",
        "name": "PSD Builder",
        "version": "2.1.0",
        "description": "A plugin that builds layered PSD files using PSD_builder.exe."
    },
    "requirements": {
        "minMemoryMb": 128,
        "minExecutionTimeMs": 10
    },
    "capabilities": [
        {
            "name": "Build PSD from Image and Texts",
            "description": "Generates a layered PSD from an image, texts and bounding boxes",
            "parameters": {
                "imagePath": {
                    "description": "Path to image",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "texts": {
                    "description": "Texts to add",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "bb": {
                    "description": "Bounding boxes to add, (xmin, ymin, xmax, ymax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "fontSize": {
                    "defaultValue": 24,
                    "description": "Font size (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "fontName": {
                    "defaultValue": "ArialMT",
                    "description": "Font name (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "outputDir": {
                    "description": "Output directory (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "leaveIntermediateFiles": {
                    "defaultValue": false,
                    "description": "Leave intermediate JSON files for debugging",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                }
            },
            "returnType": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "outputs": [
                {
                    "name": "result",
                    "description": "",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            ]
        },
        {
            "name": "Build PSD for Chapter",
            "description": "Generates layered PSDs for a folder of images concurrently",
            "parameters": {
                "inputFolder": {
                    "description": "Path to folder of images",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    },
                    "semanticTypes": [
                        {
                            "namespace": "sys",
                            "name": "directory",
                            "variant": null
                        }
                    ]
                },
                "texts": {
                    "description": "Texts to add",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "bb": {
                    "description": "Bounding boxes to add, (xmin, ymin, xmax, ymax)",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "primitive",
                                "primitiveType": "DOUBLE"
                            }
                        }
                    },
                    "semanticTypes": [
                        {
                            "namespace": "wom",
                            "name": "bounding-box",
                            "variant": null
                        }
                    ]
                },
                "pageNames": {
                    "description": "Page names corresponding to each text",
                    "type": {
                        "type": "array",
                        "items": {
                            "type": "primitive",
                            "primitiveType": "STRING"
                        }
                    }
                },
                "outputDir": {
                    "description": "Output directory",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "fontSize": {
                    "defaultValue": 24,
                    "description": "Font size (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "INT"
                    }
                },
                "fontName": {
                    "defaultValue": "ArialMT",
                    "description": "Font name (optional)",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "leaveIntermediateFiles": {
                    "defaultValue": false,
                    "description": "Leave intermediate JSON files for debugging",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "BOOLEAN"
                    }
                }
            },
            "returnType": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "outputs": [
                {
                    "name": "result",
                    "description": "",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            ]
        },
        {
            "name": "Build PSD from JSON",
            "description": "Generates a layered PSD from a given JSON file",
            "parameters": {
                "jsonPath": {
                    "description": "Path to JSON file",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                },
                "outputPsdPath": {
                    "description": "Output PSD path",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            },
            "returnType": {
                "type": "primitive",
                "primitiveType": "STRING"
            },
            "outputs": [
                {
                    "name": "result",
                    "description": "",
                    "type": {
                        "type": "primitive",
                        "primitiveType": "STRING"
                    }
                }
            ]
        }
    ],
    "changelog": {
        "releases": [
            {
                "version": "2.1.0",
                "date": "2026-05-23",
                "categories": {
                    "Changed": [
                        "Automate pkg compilation directly via Gradle build scripts."
                    ]
                }
            },
            {
                "version": "2.0.2",
                "date": "2026-05-23",
                "categories": {
                    "Changed": [
                        "Fixed executable packaging by explicitly bundling Jimp assets to resolve MODULE_NOT_FOUND errors at runtime."
                    ]
                }
            },
            {
                "version": "1.0.0",
                "date": "2026-05-23",
                "categories": {
                    "Added": [
                        "Batch capability to process entire chapters concurrently (max 4 processes via Semaphore).",
                        "Smart word-wrapping text generation to fit bounding boxes.",
                        "Set \"Anime ACE 2.0\" as default fallback font."
                    ],
                    "Changed": [
                        "Refactored `executeBuilder` to be a coroutine suspend function.",
                        "Improved cleanup with safe `try-finally` blocks for temporary JSON files.",
                        "Added option `leaveIntermediateFiles` for advanced debugging."
                    ],
                    "Initial": [
                        "Initial release with PSD Builder capabilities"
                    ]
                }
            }
        ]
    },
    "hasSetupHandler": true
}